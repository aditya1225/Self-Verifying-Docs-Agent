# Copy to .env and fill in. The pipeline runs fully offline without these
# (it falls back to the deterministic StubLLM), but the ablation numbers are
# only meaningful with a real model behind it.

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model tiers used by the resource-aware router (Ch. 16).
SVDA_MODEL_STRONG=claude-opus-5
SVDA_MODEL_CHEAP=claude-haiku-4-5

# Force the offline deterministic LLM even when a key is present (used by CI).
SVDA_FORCE_STUB_LLM=0

# Embedding + re-rank backend: "local" (sentence-transformers) or "hash" (no torch).
SVDA_EMBEDDING_BACKEND=local

# Optional Langfuse export. Traces are always written to runs/traces/*.jsonl.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
